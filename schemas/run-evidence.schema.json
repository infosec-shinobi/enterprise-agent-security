{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lab run evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "lab_id",
    "project",
    "started_at",
    "finished_at",
    "duration_ms",
    "manifest_sha256",
    "outcome",
    "exit_code",
    "reason",
    "cleanup",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "lab_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "manifest_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "enum": [
        "pass",
        "fail",
        "error"
      ]
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "cleanup": {
      "enum": [
        "not_required",
        "success",
        "error"
      ]
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario",
          "controls",
          "started_at",
          "finished_at",
          "outcome",
          "expected",
          "actual",
          "reason"
        ],
        "properties": {
          "scenario": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "controls": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]+-[0-9]{2}$"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "outcome": {
            "enum": [
              "pass",
              "fail",
              "error",
              "not_run"
            ]
          },
          "expected": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "actual": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    }
  }
}
